@model MedicalSystem.Models.PatientDetails.PatientDetailsVM
<style>
    .form-spacing .row {
        margin-top: 20px; /* Adjust the value as needed */
        margin-bottom: 20px; /* Adjust the value as needed */
    }
</style>
<section class="section profile" style="margin-top:5%;">
    <div class="container">
        <div class="row">
            <div class="col-xl-4">

                <div class="card">
                    <div class="card-body profile-card pt-4 d-flex flex-column align-items-center">

                        <img src="~/img/user.jpg" alt="Profile" class="rounded-circle" style="width:200px;">
                        <h2>@Model.Patient.FullName</h2>
                        @*<h3>Web Designer</h3>*@
                        @* <div class="social-links mt-2">
                        <a href="#" class="twitter"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
                        </div>*@
                    </div>
                </div>

            </div>

            <div class="col-xl-8">

                <div class="card">
                    <div class="card-body pt-3">
                        <!-- Bordered Tabs -->
                        <ul class="nav nav-tabs nav-tabs-bordered">

                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-overview">Detaje</button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-edit">Shto Diagnoze</button>
                            </li>

                            @* <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-settings">Diagnoza</button>
                            </li>*@

                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-change-password">Diagnoza</button>
                            </li>

                        </ul>
                        <div class="tab-content pt-2">

                            <div class="tab-pane fade show active profile-overview" id="profile-overview">

                                <h5 class="card-title">Detajet e pacientit</h5>

                                <div class="row mb-3">
                                    <label class="col-md-4 col-lg-3 col-form-label">Full Name</label>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.FullName" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Ditelindja</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.DateOfBirth" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Gjinia</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.Gender" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Adresa</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.Address" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Numri i telefonit</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.PhoneNumber" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Emaili</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.Email" disabled>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Data e krijimit</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.CreatedOn" disabled>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-3 col-md-4 label">Historiku mjekesor</div>
                                    <div class="col-md-8 col-lg-9">
                                        <input type="text" class="form-control" placeholder="@Model.Patient.MedicalHistory" disabled>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade profile-edit pt-3" id="profile-edit">

                                <!-- Profile Edit Form -->
                                <form class="form-spacing" id="diagnosisForm">
                                    @*   <div class="row mb-3">
                                    <label for="profileImage" class="col-md-4 col-lg-3 col-form-label">Profile Image</label>
                                    <div class="col-md-8 col-lg-9">
                                    <img src="~/img/user.jpg" width="35px" alt="Profile">
                                    <div class="pt-2">
                                    <a href="#" class="btn btn-primary btn-sm" title="Upload new profile image"><i class="bi bi-upload"></i></a>
                                    <a href="#" class="btn btn-danger btn-sm" title="Remove my profile image"><i class="bi bi-trash"></i></a>
                                    </div>
                                    </div>
                                    </div>*@
                                    <div class="row mb-3">
                                        <label for="name" class="col-md-4 col-lg-3 col-form-label">Pacienti</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input name="patientId" type="text" class="form-control" id="patientsName" value="@Model.Patient.FullName">
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label for="fullName" class="col-md-4 col-lg-3 col-form-label">Emri i diagnozes</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input name="diagnosisName" type="text" class="form-control" id="diagnosisName">
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <label for="description" class="col-md-4 col-lg-3 col-form-label">Pershkrimi</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input name="description" type="text" class="form-control" id="description">
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <label for="symptoms" class="col-md-4 col-lg-3 col-form-label">Simptomat</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input name="symptoms" type="text" class="form-control" id="symptoms">
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <label for="img" class="col-md-4 col-lg-3 col-form-label">Grafia</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input name="img" type="file" class="form-control" id="img">
                                        </div>
                                    </div>

                                    <div class="text-center">
                                        <button type="submit" class="btn btn-primary">Shto Diagnoze</button>
                                    </div>
                                </form><!-- End Profile Edit Form -->

                            </div>

                            <div class="tab-pane fade pt-3" id="profile-settings">
                            </div>

                            <div class="tab-pane fade pt-3" id="profile-change-password">
                                @foreach (var i in Model.Diagnoses)
                                {
                                    <div class="row mb-3">
                                        <label class="col-md-4 col-lg-3 col-form-label">Emri i diagnozes</label>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control" placeholder="@i.DiagnosisName" disabled>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-lg-3 col-md-4 label">Pershkrimi</div>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control" placeholder="@i.Description" disabled>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-lg-3 col-md-4 label">Simptomat</div>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control" placeholder="@i.Symptoms" disabled>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-lg-3 col-md-4 label">Data e Krijimit</div>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control" placeholder="@i.CreatedOn.ToString("dd/MM/yyyy")" disabled>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-lg-3 col-md-4 label">Krijuar nga</div>
                                        <div class="col-md-8 col-lg-9">
                                            <input type="text" class="form-control" placeholder="@i.DoctorName" disabled>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-lg-3 col-md-4 label">Grafia</div>
                                        <div class="col-md-8 col-lg-9">
                                            @if (!string.IsNullOrEmpty(Model.DiagnosisImageBase64))
                                            {
                                                <img src="data:image/png;base64,@Model.DiagnosisImageBase64" class="img-fluid" alt="Diagnosis Image" />
                                            }
                                            else
                                            {
                                                <span>No image available</span>
                                            }
                                        </div>
                                    </div>
                                }

                            </div>

                        </div><!-- End Bordered Tabs -->

                    </div>
                </div>

            </div>
        </div>
    </div>

</section>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $("#diagnosisForm").submit(function (event) {
            event.preventDefault();

            // Create a FormData object to handle the form data, including file uploads
            var formData = new FormData(this);

            $.ajax({
                type: "POST",
                url: "/Patients/AddDiagnosis",
                data: formData,
                processData: false, // Prevent jQuery from automatically transforming the data into a query string
                contentType: false, // Prevent jQuery from automatically setting the content type
                success: function (response) {
                    // Handle success response
                    // Optionally, perform additional actions after successful addition of diagnosis
                    location.reload();
                },
                error: function (xhr, status, error) {
                    // Handle error response
                    console.error(xhr.responseText); // Log error message
                    alert("Error occurred while adding diagnosis. Please try again."); // Display error message
                }
            });
        });
    });

</script>