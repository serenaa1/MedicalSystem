    <style>
        /* Increase the size of the bell icon */
    .nav-icon .bi-bell {
        font-size: 1.5rem; /* Adjust the size as needed */
    }

    /* Adjust the position and size of the notifications badge */
    .nav-icon .badge-number {
        position: absolute;
        top: 5px; /* Adjust vertical position */
        right: 10px; /* Adjust horizontal position */
        font-size: 0.75rem; /* Adjust font size as needed */
        padding: 0.25em 0.5em; /* Adjust padding as needed */
    }

    /* Adjust the notification dropdown items */
    .notifications .notification-item {
        font-size: 0.875rem; /* Adjust font size as needed */
    }
    /* Increase the size of the message icon */
    .nav-icon .bi-chat-left-text {
        font-size: 1.5rem; /* Adjust the size as needed */
    }

    /* Adjust the position and size of the messages badge */
    .nav-icon .badge-number {
        position: absolute;
        top: 5px; /* Adjust vertical position */
        right: 5px; /* Adjust horizontal position */
        font-size: 0.75rem; /* Adjust font size as needed */
        padding: 0.25em 0.5em; /* Adjust padding as needed */
    }

    /* Adjust the message dropdown items */
    .messages .message-item {
        font-size: 0.875rem; /* Adjust font size as needed */
    }
/* Custom CSS to change border color to blue and background to #F5F5F5 */
.custom-border {
    border-color: blue !important;
    background-color: #F5F5F5 !important;
}

.input-group .form-control.custom-border:focus {
    border-color: blue !important;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25); /* Adjust shadow color if needed */
}

.input-group .input-group-text {
    background-color: #F5F5F5 !important; /* Adjust background color to #F5F5F5 */
    border-right: 0;
    border-color: blue !important;
}

.input-group .form-control.custom-border {
    border-left: 0;
}

.input-group .btn-outline-primary.custom-border {
    border-left: 0;
    color: blue; /* Change text color to blue */
    border-color: blue !important;
}



    </style>
</head>

