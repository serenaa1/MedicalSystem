@model List<MedicalSystem.Models.Paciente.Patient>

<style>
    /* Define border styles */
    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    /* Add styling to table header */
    th {
        background-color: #f2f2f2;
    }
</style>
<style>
    /* Modal */
    .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgba(0, 0, 0, 0.4); /* Black w/ opacity */
    }

    /* Modal Content */
    .modal-content {
        background-color: #fefefe;
        margin: 15% auto; /* 15% from the top and centered */
        padding: 20px;
        border: 1px solid #888;
        width: 80%; /* Could be more or less, depending on screen size */
    }

    /* Close Button */
    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
</style>

<section id="hero" class="hero d-flex align-items-center">

    <div class="container">
        <div class="row">
            <table>
                <thead>
                    <tr>
                        <th>Emri</th>
                        <th>Gjinia</th>
                        <th>Ditelindja</th>
                        <th>Mosha</th>
                        <th>Adresa</th>
                        <th>Numri i telefonit</th>
                        <th>Email</th>
                        <th>Historia mjekesore</th>
                        <th>
                            <button type="button" class="btn btn-success" onclick="openModal()">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        DateTime currentDate = DateTime.Now;
                        TimeSpan difference = currentDate - i.DateOfBirth;
                        int age = (int)(difference.TotalDays / 365.25);
                        <tr>
                            <td onclick="openPatientDetails(@i.Id)">@i.FullName</td>
                            <td>@i.Gender</td>
                            <td>@i.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td>@age</td>
                            <td>@i.Address</td>
                            <td>@i.PhoneNumber</td>
                            <td>@i.Email</td>
                            <td>@i.MedicalHistory</td>
                            <td>
                                <button type="button" class="btn btn-info">
                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                    <i class="fa fa-trash-o" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger">
                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
<div id="myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <form>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Emri</label>
                <input type="text" class="form-control" id="name" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="flexRadioDefault" id="gender1" checked value="M">
                    <label class="form-check-label" for="flexRadioDefault1">
                        M
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="flexRadioDefault" id="gender2" value="F">
                    <label class="form-check-label" for="flexRadioDefault2">
                        F
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Ditelindja</label>
                <input type="date" class="form-control" id="date" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Adresa</label>
                <input type="text" class="form-control" id="adress" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Numri i telefonit</label>
                <input type="tel" class="form-control" id="phone" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Email address</label>
                <input type="email" class="form-control" id="email" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Historia Mjekesore</label>
                <input type="tel" class="form-control" id="history" aria-describedby="emailHelp">
            </div>
            <button type="submit" class="btn btn-primary" onclick="addPatient">Submit</button>
        </form>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>
    function openModal() {
        // Get the modal element by its id
        var modal = document.getElementById('myModal');

        // Display the modal
        modal.style.display = 'block';
    }
    function closeModal() {
        // Get the modal element by its id
        var modal = document.getElementById('myModal');

        // Hide the modal
        modal.style.display = 'none';
    }
    $(document).ready(function () {
        $("form").submit(function (event) {
            // Prevent the default form submission behavior
            event.preventDefault();

            // Get data from form inputs
            var name = $("#name").val();
            console.log(name);
            var gender = $("input[name='flexRadioDefault']:checked").val();
            var dateOfBirth = $("#date").val();
            var phone = $("#phone").val();
            var email = $("#email").val();
            var history = $("#history").val();
            var adress = $("#adress").val();

            // Create data object to send to the server
            var requestData = {
                name: name,
                gender: gender,
                dateOfBirth: dateOfBirth,
                phone: phone,
                email: email,
                history: history,
                adress: adress
            };

            // Send AJAX POST request
            $.ajax({
                type: "POST",
                url: "/Home/AddPatient",
                data: requestData,
                success: function (response) {
                    // Handle success response
                    alert(response); // Display success message
                    // Optionally, perform additional actions after successful addition of patient
                    location.reload();
                },
                error: function (xhr, status, error) {
                    // Handle error response
                    console.error(xhr.responseText); // Log error message
                    alert("Error occurred while adding patient. Please try again."); // Display error message
                }
            });
        });

    });

    function openPatientDetails(Id) {
        var url = "/Patients/Index?id=" + Id;

        window.location.href = url;
    }
</script>


