<!DOCTYPE html>
<html>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<body>
    <div style="margin-top:10%;">
        <canvas id="myChart" style="width:100%;max-width:900px; margin:auto;"></canvas>

    </div>

    <script>
        var xValues = ["Ne pritje te konsultes", "Po trajtohen", "Te trajtuar"];
        var yValues = [50, 45, 35];
        var barColors = [
            "#b91d47",
            "#00aba9",
            "#2b5797",
        ];

        new Chart("myChart", {
            type: "pie",
            data: {
                labels: xValues,
                datasets: [{
                    backgroundColor: barColors,
                    data: yValues
                }]
            },
            options: {
                title: {
                    display: true,
                    text: "Ecuria e pacienteve sot"
                }
            }
        });
    </script>

</body>
</html>
